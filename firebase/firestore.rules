rules_version = '2';

// Firestore security rules for Thulir MicroGreen Tracker. Paste into Firebase console → Firestore Database → Rules.
// The database holds only free-trial start dates, keyed by SHA-256 fingerprints (64 lower-case hex characters);
// no growing data, emails or device IDs.
service cloud.firestore {
  match /databases/{database}/documents {

    // A trial start: one field, a timestamp no later than now and no earlier than about a year ago.
    function validTrialStart() {
      return request.resource.data.keys().hasOnly(['startedAt'])
        && request.resource.data.startedAt is timestamp
        && request.resource.data.startedAt <= request.time
        && request.resource.data.startedAt > request.time - duration.value(400, 'd');
    }

    // Per device: sha256(salt + device ID). Readable one record at a time (no listing), written once, never changed.
    match /deviceTrials/{deviceKey} {
      allow get: if deviceKey.matches('^[0-9a-f]{64}$');
      allow create: if deviceKey.matches('^[0-9a-f]{64}$') && validTrialStart();
      allow list, update, delete: if false;
    }

    // Per verified email: sha256(lower-case email). Only the signed-in owner of that verified email can read or
    // create it. Kept when an account is deleted, so re-registering does not start a new trial.
    match /accountTrials/{emailKey} {
      function isOwner() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && emailKey == hashing.sha256(request.auth.token.email.lower()).toHexString().lower();
      }
      allow get: if isOwner();
      allow create: if isOwner() && validTrialStart();
      allow list, update, delete: if false;
    }

    // Everything else is closed.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
