# Copy to .env.local (git-ignored) and fill in. Read at build time by Vite.

# RevenueCat public SDK keys: RevenueCat → Project settings → API keys (one per app).
# Leave empty to build without subscriptions (nothing is locked).
# For testing without the stores, put the Test Store key (test_…, RevenueCat → Apps) in both. Never release a build
# with a test_ key: Test Store purchases are free.
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# 1 = made-up plans for trying the paywall without a store account. Never set this for a store build.
VITE_SUBSCRIPTION_TEST_MODE=

# Optional sign-in (Firebase, free Spark plan): Firebase console → Project settings → Your apps → Web app → config.
# Leave empty to build without sign-in. See docs/accounts.md.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
# Google sign-in (Android): the "Web client" OAuth client ID from Google Cloud → APIs & Services → Credentials.
VITE_GOOGLE_WEB_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxx.apps.googleusercontent.com

# 1 = simulated sign-in for trying the screens without Firebase. Never set this for a store build.
VITE_ACCOUNT_TEST_MODE=
