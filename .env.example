# Copy to .env.local (git-ignored) and fill in. Read at build time by Vite.

# RevenueCat public SDK keys: RevenueCat → Project settings → API keys (one per app).
# Leave empty to build without subscriptions (nothing is locked).
VITE_REVENUECAT_ANDROID_KEY=goog_xxxxxxxxxxxxxxxxxxxxxxxxxxx
VITE_REVENUECAT_IOS_KEY=appl_xxxxxxxxxxxxxxxxxxxxxxxxxxx

# 1 = made-up plans for trying the paywall without a store account. Never set this for a store build.
VITE_SUBSCRIPTION_TEST_MODE=
